{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private traveler and host profile stored for an authenticated Highland Sanctuary user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the traveler or host",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address",
          "minLength": 3,
          "maxLength": 150
        },
        "avatar": {
          "type": "string",
          "description": "Avatar photo URL or compressed data URL",
          "maxLength": 250000
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "location": {
          "type": "string",
          "description": "Preferred North East India state",
          "minLength": 1,
          "maxLength": 60
        },
        "isHost": {
          "type": "boolean",
          "description": "Whether the user has host mode enabled"
        },
        "hostEarningsInr": {
          "type": "number",
          "description": "Accumulated host earnings in INR"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "name", "email", "location", "isHost", "hostEarningsInr", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Reservation record for a sanctuary stay owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sanctuaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sanctuaryTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "artworkTheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 300
        },
        "checkIn": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "checkOut": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "nights": {
          "type": "number"
        },
        "guests": {
          "type": "number"
        },
        "adults": {
          "type": "number"
        },
        "children": {
          "type": "number"
        },
        "guestName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "guestEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "selectedAddonIds": {
          "type": "array"
        },
        "baseAmountInr": {
          "type": "number"
        },
        "cleaningFeeInr": {
          "type": "number"
        },
        "highlandFeeInr": {
          "type": "number"
        },
        "totalInr": {
          "type": "number"
        },
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Card", "Net Banking", "Pay at Property"]
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Cancelled"]
        },
        "bookedAt": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "sanctuaryId",
        "sanctuaryTitle",
        "location",
        "state",
        "artworkTheme",
        "photoUrl",
        "checkIn",
        "nights",
        "guests",
        "guestName",
        "guestEmail",
        "selectedAddonIds",
        "totalInr",
        "status",
        "bookedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedSanctuary": {
      "title": "SavedSanctuary",
      "description": "Saved sanctuary bookmark owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sanctuaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "sanctuaryId", "savedAt"]
    },
    "ActivityEvent": {
      "title": "ActivityEvent",
      "description": "Platform activity log entry visible to administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["save", "booking", "signup", "profile"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "type", "message", "state", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profiles keyed by Firebase Auth UID."
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "User sanctuary reservations keyed by booking ID."
    },
    "/saved/{savedId}": {
      "schema": {
        "$ref": "#/entities/SavedSanctuary"
      },
      "description": "User saved sanctuary bookmarks keyed by userId_sanctuaryId."
    },
    "/activity/{eventId}": {
      "schema": {
        "$ref": "#/entities/ActivityEvent"
      },
      "description": "Live activity stream events for admin oversight."
    }
  }
}
